# The protoc version that reproduces the committed generated code of both packages byte for byte.
# This is its only pin: generate_proto.sh refuses to run with another version, and the workflows
# that regenerate the code install this one. Dependabot cannot read this file, so nothing moves it
# automatically.
#
# Another protoc can rewrite every generated file of both packages: move PROTOC_VERSION in a change
# of its own, never inside a sync, and keep the Google.Protobuf runtime in Directory.Packages.props
# at least as new. The Twirp plugin is not pinned here: it is vendored in tools/protoc-gen-twirpcs.
#
# Plain NAME=value lines only: the workflows append them to $GITHUB_OUTPUT.
PROTOC_VERSION=36.2
