{
  "metadata": [
    {
      "src": [{ "files": ["LivekitApi/LivekitApi.csproj"], "src": ".." }],
      "dest": "obj/api-server",
      "filter": "filter.yml",
      "globalNamespaceId": "Global",
      "properties": { "NoWarn": "CS0612;CS0618" }
    },
    {
      "src": [{ "files": ["LivekitRtc/LivekitRtc.csproj"], "src": ".." }],
      "dest": "api-rtc",
      "filter": "filter.yml",
      "properties": { "NoWarn": "CS0612;CS0618" }
    }
  ],
  "build": {
    "content": [
      { "files": ["toc.yml", "index.md", "api-server/toc.yml", "api-rtc/**.yml"] },
      { "files": ["**.yml"], "exclude": ["toc.yml"], "src": "obj/api-server", "dest": "api-server" },
      { "files": ["*.md"], "src": "redirects", "dest": "api-server" }
    ],
    "overwrite": [{ "files": ["namespaces/*.md"] }],
    "xref": ["protobuf-xrefmap.yml"],
    "output": "_site",
    "template": ["default", "modern"],
    "sitemap": {
      "baseUrl": "https://pablofuente.github.io/livekit-server-sdk-dotnet/",
      "changefreq": "weekly"
    },
    "globalMetadata": {
      "_appTitle": "LiveKit .NET SDKs",
      "_appFooter": "<a href=\"https://github.com/pabloFuente/livekit-server-sdk-dotnet\">livekit-server-sdk-dotnet on GitHub</a>",
      "_enableSearch": true
    }
  }
}
